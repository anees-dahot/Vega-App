<resources xmlns:tools="http://schemas.android.com/tools">
  <style name="AppTheme" parent="Theme.EdgeToEdge">
    <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:textColor">@android:color/white</item>
  </style>
  <style name="Theme.App.SplashScreen" parent="AppTheme">
    <item name="android:windowBackground">@drawable/splashscreen_logo</item>
  </style>
  <style name="BootTheme" parent="BootTheme.White"/>
  <style name="BootTheme.Base" parent="Theme.BootSplash.EdgeToEdge">
    <item name="postBootSplashTheme">@style/AppTheme</item>
    <item name="bootSplashBackground">@color/bootsplash_background</item>
  </style>
  <style name="BootTheme.White" parent="BootTheme.Base">
    <item name="bootSplashLogo">@drawable/bootsplash_logo_white</item>
  </style>
  <style name="BootTheme.Tomato" parent="BootTheme.Base">
    <item name="bootSplashLogo">@drawable/bootsplash_logo_tomato</item>
  </style>
  <style name="BootTheme.Gray" parent="BootTheme.Base">
    <item name="bootSplashLogo">@drawable/bootsplash_logo_gray</item>
  </style>
  <style name="BootTheme.Blue" parent="BootTheme.Base">
    <item name="bootSplashLogo">@drawable/bootsplash_logo_blue</item>
  </style>
  <style name="BootTheme.Lavender" parent="BootTheme.Base">
    <item name="bootSplashLogo">@drawable/bootsplash_logo_lavender</item>
  </style>
</resources>